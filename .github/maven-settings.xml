<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for the GitHub workflows.

  .mvn/extensions.xml loads git-changelist-maven-extension, which is published on
  repo.jenkins-ci.org and not on Maven Central. Maven resolves build extensions before it reads
  pom.xml, so the repositories declared there do not apply; only the plugin repositories from
  settings do. Without this file a build passes only when a restored cache already holds the
  extension. ci.jenkins.io supplies equivalent settings itself.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <profiles>
    <profile>
      <id>jenkins</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <repositories>
        <repository>
          <id>repo.jenkins-ci.org</id>
          <url>https://repo.jenkins-ci.org/public/</url>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>repo.jenkins-ci.org</id>
          <url>https://repo.jenkins-ci.org/public/</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
</settings>
